{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@os/sdk": ["src/renderer/src/os/sdk/index.ts"],
      "@os/sdk/*": ["src/renderer/src/os/sdk/*"],
      "@os/ui": ["src/renderer/src/os/ui/index.ts"],
      "@os/ui/*": ["src/renderer/src/os/ui/*"],
      "@system": ["src/renderer/src/system/index.ts"],
      "@system/*": ["src/renderer/src/system/*"],
      "@shared": ["src/shared/index.ts"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*"
  ]
}
